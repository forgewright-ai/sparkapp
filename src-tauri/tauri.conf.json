{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "spark",
  "version": "0.1.0",
  "identifier": "com.forgewright.spark",
  "build": {
    "frontendDist": "../page"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "spark",
        "width": 900,
        "height": 700,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
